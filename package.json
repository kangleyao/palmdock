{
  "name": "palmdock",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "palmdock（掌坞）：供 AI 按需适配的通用手机任务底座（公共页面/通信/鉴权/任务展示可复用，差异集中在适配器）",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/index.js",
    "token": "node dist/src/tools/gentoken.js",
    "serve": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/serve.ps1",
    "test": "tsc -p tsconfig.json && node --test \"dist/tests/*.test.js\""
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "ws": "^8.22.0"
  }
}
